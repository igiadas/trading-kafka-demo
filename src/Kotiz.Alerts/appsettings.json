{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "alerts"
  },
  "Alerts": {
    "TelegramBotToken": "",
    "TelegramChatId": "",
    "PriceMoveThresholdPercent": 2,
    "PriceMoveWindow": "00:05:00"
  }
}
