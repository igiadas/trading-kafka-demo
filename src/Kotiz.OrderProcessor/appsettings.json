{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "order-processor"
  },
  "Trading": {
    "TradableSymbols": [ "SAN", "BBVA", "ITX", "IBE", "TEF", "REP" ]
  },
  "Retry": {
    "MaxAttempts": 3,
    "BaseDelay": "00:00:00.500"
  }
}
