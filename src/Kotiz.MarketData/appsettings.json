{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Market": {
    "Source": "Simulated",
    "Symbols": "AAPL,MSFT,NVDA,TSLA,AMZN",
    "PublishInterval": "00:00:01"
  }
}
