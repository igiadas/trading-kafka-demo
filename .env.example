# Copy this file to .env (which git ignores) and fill in what you need.
# Every value is optional: without a .env, Kotiz runs with simulated prices and logs its alerts.

# Simulated (default) or Finnhub. Finnhub needs FINNHUB_API_KEY (free at https://finnhub.io/register).
MARKET_DATA_SOURCE=Simulated
FINNHUB_API_KEY=

# Symbols to stream and trade. Finnhub's free plan covers US stocks and crypto, for example
# BINANCE:BTCUSDT, which trades 24/7 (handy outside US market hours, 15:30-22:00 CET).
SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMZN

# Optional Telegram alerts: create a bot with @BotFather (token) and get your chat id (see README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
